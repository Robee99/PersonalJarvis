+export function trustedParentOrigin(origin, location = globalThis.location) {
+  if (typeof origin !== 'string' || !origin || origin === 'null') return false;
+  const ancestors = location?.ancestorOrigins;
+  if (ancestors && ancestors.length) return origin === ancestors[0];
+  try {
+    const url = new URL(origin);
