+test('an embedded page draws incidents, reports clicks and cleans up', async () => {
+  const posted = [];
+  const parent = {
+    postMessage: (message, target) => posted.push([message, target]),
+  };
+  const windowRef = new EventTarget();
+  windowRef.parent = parent;
+  windowRef.document = { body: { classList: new Set() } };
+  windowRef.document.body.classList.add = Set.prototype.add;
+  windowRef.dispatchEvent(new Event('noop'));
+  const added = [];
+  const removed = [];
+  let clickAction = null;
+  let picked;
+  const handler = {
+    destroyed: false,
+    setInputAction: (fn) => {
+      clickAction = fn;
+    },
+    destroy() {
+      this.destroyed = true;
+    },
+  };
+  const viewer = {
+    ...fakeViewer(),
+    dataSources: {
+      add: (ds) => added.push(ds),
+      remove: (ds) => removed.push(ds),
+    },
+    scene: { canvas: {}, pick: () => picked },
+  };
+  const { run } = recorder();
+  const origin = 'http://127.0.0.1:8765';
+  const remove = installViews({
+    shell: { initialRestorePromise: Promise.resolve(), setCleanView() {} },
+    viewer,
+    dataManager: fakeLayers(new Set()),
+    run,
+    location: { search: '?embed=1', hash: '', ancestorOrigins: [origin] },
+    windowRef,
+    createIncidentClickHandler: () => handler,
+  });
+  const send = (data, from = origin) => {
+    const event = new Event('message');
+    Object.assign(event, { source: parent, data, origin: from });
+    windowRef.dispatchEvent(event);
+  };
+  const quake = {
+    id: 'usgs:us6000u3bc',
+    lat: -14.03,
+    lon: 165.71,
+    kind: 'earthquake',
+    category: 'hazard',
+    severity: 2,
+    evidence: 'measured',
+    title: 'M 5.9 earthquake',
+    time: 1,
+    source: 'usgs',
+  };
+  send(
+    {
+      type: 'gev:events-upsert',
+      v: 1,
+      id: 'x',
+      replace: true,
+      events: [quake],
+    },
+    'https://evil.example',
+  );
+  send({ type: 'gev:events-upsert', v: 9, id: 'old' });
+  send({
+    type: 'gev:events-upsert',
+    v: 1,
+    id: 'm1',
+    replace: true,
+    events: [quake, { id: 'bad' }],
+  });
+  await new Promise((resolve) => setTimeout(resolve, 10));
+  const answers = posted.filter(([m]) => m.type === 'gev:events-applied');
+  assert.deepEqual(
+    answers.map(([m]) => [m.id, m.ok]),
+    [
+      ['old', false],
+      ['m1', true],
+    ],
+  );
+  assert.equal(answers[1][0].rejected, 1);
+  assert.ok(answers.every(([, target]) => target === origin));
+  assert.equal(added.length, 1, 'one incident layer, created on demand');
+  assert.equal(added[0].entities.values.length, 1);
+
+  picked = { id: added[0].entities.getById('external-event:usgs:us6000u3bc') };
+  clickAction({ position: { x: 0, y: 0 } });
+  const selected = posted.find(([m]) => m.type === 'gev:event-selected');
+  assert.deepEqual(selected, [
+    {
+      type: 'gev:event-selected',
+      v: 1,
+      eventId: 'usgs:us6000u3bc',
+      via: 'click',
+    },
+    origin,
+  ]);
+
+  remove();
+  assert.equal(handler.destroyed, true);
+  assert.equal(removed.length, 1);
+});
diff --git a/src/layers/externalEvents/externalEvents.test.mjs b/src/layers/externalEvents/externalEvents.test.mjs
new file mode 100644
index 00000000..10c5f07c
--- /dev/null
+++ b/src/layers/externalEvents/externalEvents.test.mjs
@@ -0,0 +1,228 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  MAX_EXTERNAL_EVENTS,
+  cleanTitle,
+  createExternalEventsLayer,
+  diffIncidents,
+  normalizeIncident,
+  readIncidents,
+} from './index.js';
+
+const incident = (id, extra = {}) => ({
+  id,
+  lat: 28.6,
+  lon: 77.2,
+  kind: 'protest',
+  category: 'unrest',
+  severity: null,
+  evidence: 'media',
+  title: 'Protest reported in New Delhi',
+  time: 1792400000000,
+  source: 'gdelt',
+  ...extra,
+});
+
+/** A viewer with just what the layer touches, and a click handler to drive. */
+function fakeViewer() {
+  const added = [];
+  const removed = [];
+  const flights = [];
+  let homes = 0;
+  let clickAction = null;
+  let picked;
+  const viewer = {
+    dataSources: {
+      add: (ds) => {
+        added.push(ds);
+        return Promise.resolve(ds);
+      },
+      remove: (ds, destroy) => {
+        removed.push([ds, destroy]);
+        return true;
+      },
+    },
+    scene: {
+      canvas: {},
+      pick: () => picked,
+      requestRender: () => {},
+    },
+    camera: {
+      flyTo: (options) => flights.push(options),
+      flyHome: () => {
+        homes += 1;
+      },
+    },
+  };
+  const handler = {
+    destroyed: false,
+    setInputAction: (fn) => {
+      clickAction = fn;
+    },
+    destroy() {
+      this.destroyed = true;
+    },
+  };
+  return {
+    viewer,
+    handler,
+    added,
+    removed,
+    flights,
+    homes: () => homes,
+    click: (pick) => {
+      picked = pick;
+      clickAction({ position: { x: 1, y: 1 } });
+    },
+    createClickHandler: () => handler,
+  };
+}
+
+test('incidents are validated: id, position, bounded plain title', () => {
+  assert.equal(normalizeIncident(incident('a', { lat: 91 })), null);
+  assert.equal(normalizeIncident(incident('a', { lat: 0, lon: 0 })), null);
+  assert.equal(normalizeIncident(incident('a', { lat: '28.6' })), null);
+  assert.equal(normalizeIncident(incident('a', { lat: Number.NaN })), null);
+  assert.equal(normalizeIncident(incident('<script>')), null);
+  assert.equal(normalizeIncident(incident('x'.repeat(201))), null);
+  const kept = normalizeIncident(
+    incident('gdelt:protest--2106102-20261019', {
+      title: 'A‮\u0007  b\n<img src=x onerror=alert(1)>',
+      severity: 9,
+      evidence: 'confirmed',
+      kind: 'Robbery!',
+    }),
+  );
+  assert.equal(kept.title, 'A b <img src=x onerror=alert(1)>');
+  assert.equal(kept.severity, null);
+  // An unknown evidence class is never upgraded: it becomes the weakest.
+  assert.equal(kept.evidence, 'media');
+  assert.equal(kept.kind, 'other');
+  assert.equal(cleanTitle('x'.repeat(400)).length, 160);
+});
+
+test('a message keeps the first of each id and counts the rest', () => {
+  const { incidents, rejected } = readIncidents([
+    incident('a'),
+    incident('a'),
+    { id: 'b' },
+    'junk',
+    incident('c'),
+  ]);
+  assert.deepEqual(
+    incidents.map((i) => i.id),
+    ['a', 'c'],
+  );
+  assert.equal(rejected, 3);
+  assert.deepEqual(readIncidents('nope'), {
+    incidents: [],
+    rejected: 0,
+    truncated: false,
+  });
+});
+
+test('diff adds, changes, removes on replace, and never grows past the cap', () => {
+  const current = new Map([
+    ['a', normalizeIncident(incident('a'))],
+    ['b', normalizeIncident(incident('b'))],
+  ]);
+  const next = [
+    normalizeIncident(incident('a', { title: 'changed' })),
+    normalizeIncident(incident('c')),
+  ];
+  assert.deepEqual(
+    Object.fromEntries(
+      Object.entries(diffIncidents(current, next, true)).map(([k, v]) => [
+        k,
+        v.map((i) => i.id ?? i),
+      ]),
+    ),
+    { add: ['c'], change: ['a'], remove: ['b'] },
+  );
+  assert.deepEqual(diffIncidents(current, next, false).remove, []);
+  const full = new Map(
+    Array.from({ length: MAX_EXTERNAL_EVENTS }, (_, i) => [
+      `f${i}`,
+      normalizeIncident(incident(`f${i}`)),
+    ]),
+  );
+  assert.equal(
+    diffIncidents(full, [normalizeIncident(incident('new'))], false).add.length,
+    0,
+  );
+});
+
+test('the layer draws one entity per id and leaves no orphans', () => {
+  const fake = fakeViewer();
+  const layer = createExternalEventsLayer({
+    viewer: fake.viewer,
+    createClickHandler: fake.createClickHandler,
+  });
+  const ds = fake.added[0];
+  layer.upsert([incident('a'), incident('b'), incident('bad', { lat: 200 })], {
+    replace: true,
+  });
+  assert.equal(ds.entities.values.length, 2);
+  const result = layer.upsert([incident('b'), incident('c')], {
+    replace: true,
+  });
+  assert.deepEqual(result, {
+    applied: 1,
+    removed: 1,
+    rejected: 0,
+    truncated: false,
+  });
+  assert.deepEqual(ds.entities.values.map((e) => e.id).sort(), [
+    'external-event:b',
+    'external-event:c',
+  ]);
+  layer.remove(['c', 42]);
+  assert.equal(layer.size, 1);
+  layer.clear();
+  assert.equal(ds.entities.values.length, 0);
+  layer.destroy();
+  assert.equal(fake.handler.destroyed, true);
+  assert.equal(fake.removed.length, 1);
+  // A destroyed layer ignores late messages.
+  layer.upsert([incident('z')]);
+  assert.equal(layer.size, 0);
+});
+
+test('clicks select our incidents only; selection flies only when asked', () => {
+  const fake = fakeViewer();
+  const selected = [];
+  const cleared = [];
+  const layer = createExternalEventsLayer({
+    viewer: fake.viewer,
+    createClickHandler: fake.createClickHandler,
+    onSelect: (id) => selected.push(id),
+    onClear: (reason) => cleared.push(reason),
+  });
+  layer.upsert([incident('a'), incident('b', { lat: -14, lon: 165 })]);
+  const entity = fake.added[0].entities.getById('external-event:b');
+  fake.click({ id: entity });
+  assert.deepEqual(selected, ['b']);
+  assert.equal(layer.selected, 'b');
+  const ring = () => entity.point.outlineWidth.getValue();
+  assert.equal(ring(), 3, 'the selected incident is ringed');
+  assert.equal(entity.label, undefined, 'world text stays in the overlay host');
+  assert.equal(fake.flights.length, 0);
+  // Another layer's object leaves the selection alone; empty globe clears it.
+  fake.click({ id: 'flight:abc' });
+  assert.equal(layer.selected, 'b');
+  fake.click(undefined);
+  assert.equal(layer.selected, null);
+  assert.deepEqual(cleared, ['empty-click']);
+  assert.equal(ring(), 1);
+  // Selecting from the page flies there; an unknown id selects nothing.
+  layer.select('a', { fly: true });
+  assert.equal(fake.flights.length, 1);
+  assert.equal(layer.select('nope'), false);
+  // Removing the selected incident clears the selection.
+  layer.select('a');
+  layer.upsert([], { replace: true });
+  assert.deepEqual(cleared, ['empty-click', 'removed']);
+  layer.home();
+  assert.equal(fake.homes(), 1);
+  layer.destroy();
+});
