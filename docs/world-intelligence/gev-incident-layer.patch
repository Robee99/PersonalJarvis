+/**
+ * Incidents a framing page (JARVIS) sends to the globe: validation and the
+ * difference between what is drawn and what was sent.
+ *
+ * Everything here is untrusted input from another window. An incident is
+ * kept only with a well-formed id and a real position; its title is plain,
+ * bounded text that is only ever drawn as a label, never parsed as markup.
+ * Nothing in a message is followed as an instruction.
+ */
+
+export const EXTERNAL_EVENTS_VERSION = 1;
+export const EXTERNAL_EVENTS_CAPABILITY = 'events@1';
+/** The most incidents drawn at once, and in one message. */
+export const MAX_EXTERNAL_EVENTS = 2000;
+export const TITLE_MAX = 160;
+const ID_PATTERN = /^[A-Za-z0-9:._-]{1,200}$/;
+const TOKEN_PATTERN = /^[a-z_]{1,24}$/;
+const EVIDENCE = new Set(['measured', 'agency', 'media']);
+// Control and bidirectional-override characters that could disguise a title.
+const CONTROL = /[\u0000-\u001f\u007f-\u009f​-‏‪-‮⁦-⁩]/g;
+
+function finite(value) {
+  return typeof value === 'number' && Number.isFinite(value) ? value : null;
+}
+
+function token(value, fallback) {
+  return typeof value === 'string' && TOKEN_PATTERN.test(value)
+    ? value
+    : fallback;
+}
+
+/** Plain single-line text, at most TITLE_MAX characters. */
+export function cleanTitle(value) {
+  if (typeof value !== 'string') return '';
+  const text = value.replace(/\s+/g, ' ').replace(CONTROL, '').trim();
+  return text.length <= TITLE_MAX ? text : `${text.slice(0, TITLE_MAX - 1)}…`;
+}
+
+export function isIncidentId(value) {
+  return typeof value === 'string' && ID_PATTERN.test(value);
+}
+
+/** One incident as the layer draws it, or null when it cannot be drawn. */
+export function normalizeIncident(raw) {
+  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return null;
+  if (!isIncidentId(raw.id)) return null;
+  const lat = finite(raw.lat);
+  const lon = finite(raw.lon);
+  if (lat === null || lon === null) return null;
+  if (lat < -90 || lat > 90 || lon < -180 || lon > 180) return null;
+  if (lat === 0 && lon === 0) return null;
+  const severity = finite(raw.severity);
+  return {
+    id: raw.id,
+    lat,
+    lon,
+    kind: token(raw.kind, 'other'),
+    category: token(raw.category, 'hazard'),
+    severity:
+      severity !== null &&
+      Number.isInteger(severity) &&
+      severity >= 0 &&
+      severity <= 4
+        ? severity
+        : null,
+    evidence: EVIDENCE.has(raw.evidence) ? raw.evidence : 'media',
+    title: cleanTitle(raw.title),
+    time: finite(raw.time),
+    source: token(raw.source, 'unknown'),
+  };
+}
+
+/** The valid incidents of a message (first of each id), and how many were refused. */
+export function readIncidents(list) {
+  if (!Array.isArray(list))
+    return { incidents: [], rejected: 0, truncated: false };
+  const seen = new Set();
+  const incidents = [];
+  let rejected = 0;
+  for (const raw of list.slice(0, MAX_EXTERNAL_EVENTS)) {
+    const incident = normalizeIncident(raw);
+    if (!incident || seen.has(incident.id)) {
+      rejected += 1;
+      continue;
+    }
+    seen.add(incident.id);
+    incidents.push(incident);
+  }
+  return { incidents, rejected, truncated: list.length > MAX_EXTERNAL_EVENTS };
+}
+
+function same(a, b) {
+  return (
+    a.lat === b.lat &&
+    a.lon === b.lon &&
+    a.kind === b.kind &&
+    a.category === b.category &&
+    a.severity === b.severity &&
+    a.evidence === b.evidence &&
+    a.title === b.title &&
+    a.time === b.time &&
+    a.source === b.source
+  );
+}
+
+/**
+ * What to add, change and remove to go from `current` (a Map by id) to
+ * `incoming`. With `replace`, anything not in `incoming` is removed.
+ */
+export function diffIncidents(current, incoming, replace) {
+  const add = [];
+  const change = [];
+  const keep = new Set();
+  for (const incident of incoming) {
+    keep.add(incident.id);
+    const held = current.get(incident.id);
+    if (!held) add.push(incident);
+    else if (!same(held, incident)) change.push(incident);
+  }
+  const remove = replace
+    ? [...current.keys()].filter((id) => !keep.has(id))
+    : [];
+  // Never grow past the cap: drop the excess additions.
+  const room = MAX_EXTERNAL_EVENTS - (current.size - remove.length);
+  return { add: add.slice(0, Math.max(0, room)), change, remove };
+}
+
+/** Marker colour (CSS) and size in pixels for an incident. */
+export function incidentStyle(incident) {
+  const severity = incident.severity ?? 0;
+  const color =
+    incident.evidence === 'media'
+      ? '#c794ff'
+      : severity >= 4
+        ? '#ff4738'
+        : severity >= 3
+          ? '#ff8a2a'
+          : '#ffc74d';
+  return { color, pixelSize: 7 + severity * 2 };
+}
