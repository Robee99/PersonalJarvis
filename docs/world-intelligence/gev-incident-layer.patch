+import * as Cesium from 'cesium';
+import {
+  registerPickOwner,
+  resolvePickId,
+  unregisterPickOwner,
+} from '../../data/pickRegistry.js';
+import { diffIncidents, incidentStyle, readIncidents } from './records.js';
+export * from './records.js';
+
+export const EXTERNAL_EVENTS_LAYER_ID = 'external-events';
+const ENTITY_PREFIX = 'external-event:';
+const FOCUS_ALTITUDE_M = 2_500_000;
+const FLIGHT_SECONDS = 1.5;
+
+/**
+ * Incidents a framing page sends, drawn as points the person can click.
+ *
+ * The page owns the list (ids, positions, titles); this layer only draws it,
+ * keeps one entity per id (a replace removes what the page dropped, so no
+ * marker outlives its incident), rings the selected one (its title is shown by
+ * the framing page, since GEV keeps world text in its overlay host),
+ * and reports clicks through `onSelect` / `onClear`. It sits outside the
+ * layer catalog, so a view applied to the globe never turns it off.
+ */
+export function createExternalEventsLayer({
+  viewer,
+  onSelect = () => {},
+  onClear = () => {},
+  beforeFlight = () => {},
+  createClickHandler = (canvas) => new Cesium.ScreenSpaceEventHandler(canvas),
+}) {
+  const dataSource = new Cesium.CustomDataSource('jarvis-incidents');
+  void viewer.dataSources.add(dataSource);
+  const drawn = new Map();
+  let selected = null;
+  let destroyed = false;
+
+  const entityId = (id) => `${ENTITY_PREFIX}${id}`;
+  registerPickOwner(EXTERNAL_EVENTS_LAYER_ID, (pickedId) =>
+    pickedId.startsWith(ENTITY_PREFIX),
+  );
+
+  const paint = (entity, incident) => {
+    const style = incidentStyle(incident);
+    const isSelected = incident.id === selected;
+    entity.position = Cesium.Cartesian3.fromDegrees(
+      incident.lon,
+      incident.lat,
+      300,
+    );
+    entity.point = new Cesium.PointGraphics({
+      pixelSize: isSelected ? style.pixelSize + 6 : style.pixelSize,
+      color: Cesium.Color.fromCssColorString(style.color).withAlpha(0.92),
+      outlineColor: isSelected
+        ? Cesium.Color.WHITE
+        : Cesium.Color.BLACK.withAlpha(0.6),
+      outlineWidth: isSelected ? 3 : 1,
+      heightReference: Cesium.HeightReference.RELATIVE_TO_GROUND,
+    });
+  };
+
+  const repaint = (id) => {
+    const incident = drawn.get(id);
+    const entity = incident && dataSource.entities.getById(entityId(id));
+    if (incident && entity) paint(entity, incident);
+  };
+
+  const handler = createClickHandler(viewer.scene.canvas);
+  handler.setInputAction((click) => {
+    if (destroyed) return;
+    const picked = viewer.scene.pick(click.position);
+    const pickedId = resolvePickId(picked);
+    if (pickedId?.startsWith(ENTITY_PREFIX)) {
+      const id = pickedId.slice(ENTITY_PREFIX.length);
+      if (drawn.has(id)) {
+        layer.select(id, { fly: false });
+        onSelect(id);
+      }
+      return;
+    }
+    // A click on empty globe clears the selection; a click on another
+    // layer's object leaves it alone.
+    if (!picked && selected) {
+      layer.select(null);
+      onClear('empty-click');
+    }
+  }, Cesium.ScreenSpaceEventType.LEFT_CLICK);
+
+  const layer = {
+    id: EXTERNAL_EVENTS_LAYER_ID,
+
+    /** Add or update incidents; with `replace`, drop every one not listed. */
+    upsert(list, { replace = false } = {}) {
+      if (destroyed)
+        return { applied: 0, removed: 0, rejected: 0, truncated: false };
+      const { incidents, rejected, truncated } = readIncidents(list);
+      const { add, change, remove } = diffIncidents(drawn, incidents, replace);
+      dataSource.entities.suspendEvents();
+      try {
+        for (const id of remove) {
+          dataSource.entities.removeById(entityId(id));
+          drawn.delete(id);
+        }
+        for (const incident of [...add, ...change]) {
+          drawn.set(incident.id, incident);
+          const entity =
+            dataSource.entities.getById(entityId(incident.id)) ??
+            dataSource.entities.add(
+              new Cesium.Entity({ id: entityId(incident.id) }),
+            );
+          paint(entity, incident);
+        }
+      } finally {
+        dataSource.entities.resumeEvents();
+      }
+      if (selected && !drawn.has(selected)) {
+        selected = null;
+        onClear('removed');
+      }
+      viewer.scene.requestRender?.();
+      return {
+        applied: add.length + change.length,
+        removed: remove.length,
+        rejected,
+        truncated,
+      };
+    },
+
+    remove(ids) {
+      if (destroyed || !Array.isArray(ids)) return 0;
+      let removed = 0;
+      for (const id of ids.slice(0, 2000)) {
+        if (typeof id === 'string' && drawn.delete(id)) {
+          dataSource.entities.removeById(entityId(id));
+          removed += 1;
+          if (selected === id) {
+            selected = null;
+            onClear('removed');
+          }
+        }
+      }
+      viewer.scene.requestRender?.();
+      return removed;
+    },
+
+    clear() {
+      if (destroyed) return;
+      dataSource.entities.removeAll();
+      drawn.clear();
+      if (selected) {
+        selected = null;
+        onClear('removed');
+      }
+      viewer.scene.requestRender?.();
+    },
+
+    /** Highlight an incident (or none); with `fly`, move the camera to it. */
+    select(id, { fly = false } = {}) {
+      if (destroyed) return false;
+      const previous = selected;
+      selected = id && drawn.has(id) ? id : null;
+      if (previous && previous !== selected) repaint(previous);
+      if (selected) repaint(selected);
+      viewer.scene.requestRender?.();
+      if (selected && fly) {
+        const incident = drawn.get(selected);
+        beforeFlight();
+        viewer.camera.flyTo({
+          destination: Cesium.Cartesian3.fromDegrees(
+            incident.lon,
+            incident.lat,
+            FOCUS_ALTITUDE_M,
+          ),
+          duration: FLIGHT_SECONDS,
+        });
+      }
+      return selected !== null || id === null;
+    },
+
+    home() {
+      if (destroyed) return;
+      beforeFlight();
+      viewer.camera.flyHome(FLIGHT_SECONDS);
+    },
+
+    get size() {
+      return drawn.size;
+    },
+
+    get selected() {
+      return selected;
+    },
+
+    destroy() {
+      if (destroyed) return;
+      destroyed = true;
+      handler.destroy();
+      unregisterPickOwner(EXTERNAL_EVENTS_LAYER_ID);
+      drawn.clear();
+      viewer.dataSources.remove(dataSource, true);
+    },
+  };
+  return layer;
+}
