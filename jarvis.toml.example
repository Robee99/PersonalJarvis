# ============================================================
#  Personal Jarvis — configuration TEMPLATE
# ------------------------------------------------------------
#  This file is OPTIONAL. Jarvis boots with no jarvis.toml at all
#  (every value below has a built-in default in jarvis/core/config.py).
#  Copy this to `jarvis.toml` only if you want to override defaults:
#      cp jarvis.toml.example jarvis.toml
#
#  SECRETS DO NOT GO HERE. API keys live in your OS credential manager
#  (run `python -m jarvis --wizard`) or in `.env` (see .env.example).
#  Never commit a real jarvis.toml — it is gitignored.
#
#  Overrides cascade: jarvis.toml  →  ENV (JARVIS__SECTION__KEY=...)
#  Any section you delete falls back to the code defaults.
#  This template ships LOCAL-FIRST defaults: Jarvis's own brain on a
#  local llama.cpp server (Gemma 4 E4B or Nemotron Bolt E4B), local
#  speech in and out, nothing paid and no API key needed. Paid and
#  cloud brains are deny-listed below; each one is opt-in, never a
#  fallback. `jarvis system local` sets the same on a running app.
# ============================================================

[profile]
name = "default"
language = "auto"            # "de" | "en" | "auto" (bilingual auto-detect)

[persona]
# The assistant's name. Empty -> derived from your chosen wake-word phrase
# below (e.g. a phrase like "Hey Nova" gives the name "Nova"). Leave blank
# to keep the default. The wake word is always YOUR choice — nothing is
# preset for you.
name = ""
# "butler" (default): a calm English butler who addresses you with the
# honorific below, sparingly. "companion": a warm peer, no honorific.
style = "butler"
honorific = "Sir"

# ── Voice trigger (optional; irrelevant on a headless/browser-only host) ──
[trigger]
wake_word_enabled = true     # always-on wake listener (needs a mic)
single_turn_mode = false     # false = conversation stays open until "hang up"/idle
hotkey_pet_toggle = "alt+win+p"  # hide / show the desktop pet (macOS: cmd+alt+p); "" = off

[trigger.wake_word]
# Type any phrase you like — no wake word ships with the product (design
# 2026-07-07). "auto" resolves the best generic engine for your phrase:
# your own trained .onnx -> any-word Vosk keyword spotting -> local-Whisper
# transcript match -> honest hotkey-only mode with a clear message.
# Leave blank to pick your word during onboarding.
phrase = ""
engine = "auto"              # auto | openwakeword | vosk_kws | stt_match | custom_onnx
sensitivity = 0.5            # 0.5..1 (values below 0.5 are lifted — the wake would be deaf)

# ── Speech-to-Text ──
[stt]
provider = "faster-whisper"  # faster-whisper | nemotron-local (both on this machine) | groq-api | openai-api | openrouter-stt | gemini-api | vertex-stt
device = "cpu"               # cpu | cuda — keep "cpu" unless you have a local GPU
language = "auto"            # auto, or a weak ISO-639 preference such as "fr"
bias_prompt = ""             # optional comma-separated vocab to stabilize proper nouns
temperature = 0.0            # deterministic when the selected model supports it

# Cloud model pins are provider-specific; an omitted pin uses that plugin's
# default. Configure these in the app's model picker in normal use.
[stt.models]
# openai-api = "gpt-4o-transcribe"
# openrouter-stt = "openai/gpt-4o-transcribe"

# ── Dictation quality ──
[dictation]
# Short segments update the live preview. Delivery comes from a second pass
# over the complete recording in long overlapping windows.
final_quality_pass = true
final_window_seconds = 25.0
final_overlap_seconds = 1.5
# Auto-detect each final window so language changes remain in the spoken
# language. Turn this off only to apply the preference as a hard monolingual pin.
code_switching = true

# ── Text-to-Speech ──
# Default = Piper on this machine (keyless, offline). Opt-in cloud voices:
#   provider = "gemini-flash-tts" (GEMINI_API_KEY), "cartesia" (CARTESIA_API_KEY
#   + [tts.cartesia] voice ids), "grok-voice" (GROK_API_KEY), "elevenlabs"
#   (ELEVENLABS_API_KEY).
[tts]
provider = "piper-local"
fallback = ""
language_code = "auto"
streaming = true
# Legacy TTS-only Vertex route (predates the [google] section below). Kept for
# existing installs; new setups should pick provider = "vertex-tts" instead, which
# shares ONE Vertex credential with the brain, STT and realtime tiers.
use_vertex = false
vertex_project = ""
service_account_path = "~/.config/jarvis/vertex-sa.json"

# ── Google endpoint routing (AI Studio vs Google Cloud Vertex AI) ──
# vertex_mode decides where an AMBIGUOUS key stored in a Gemini slot goes:
#   "auto"   probe once per process and remember (default)
#   "always" force Vertex   |   "never" force AI Studio
# The vertex_* fields below configure the dedicated Vertex provider family
# (brain "vertex", stt "vertex-stt", tts "vertex-tts", realtime "vertex-live",
# and the same slug as a subagent). Leave vertex_project empty to authenticate
# with a Vertex API key; set it to use a Google Cloud project with Application
# Default Credentials and no key at all.
# Note that Vertex takes an API key ONLY in express mode (AQ.). A normal Cloud
# project authenticates via Application Default Credentials — no key at all:
#   gcloud auth application-default login
[google]
vertex_mode = "auto"
vertex_project = ""
# "global" carries the current Gemini generation; a named region (europe-west4,
# us-central1, …) is what data residency needs — and regions lag on new models.
vertex_location = "global"
# The Live/realtime socket is a DIFFERENT endpoint: "global" serves no Live
# session at all, so realtime needs a region. Empty = follow vertex_location
# when it names a region, else fall back to a region and log which one.
vertex_realtime_location = ""
service_account_path = ""     # only when this machine is not signed in with gcloud

# ── Brain (multi-provider; never hardcode a single vendor) ──
# Default = Jarvis's own brain on a local llama.cpp server (the model swapper
# fronts Gemma 4 E4B QAT on :11443 and Nemotron 3.5 Bolt E4B on :11442). No
# key, nothing leaves the machine. To use a cloud brain instead, change these
# four to "gemini" | "claude-api" | "openai" | "grok" | "openrouter" | "vertex",
# supply that provider's key, and take it off deny_providers below.
[brain]
primary = "local-openai"
fallback = "local-openai"
deep_brain = "local-openai"
routing_provider = "local-openai"
routing_model = "gemma-4b-qat"
# A small local model sees the core tools plus the ones a request needs, and
# switches more on with `enable_tools` ("auto" does this for local brains).
tool_switch = "auto"

[brain.providers.gemini]
model = "gemini-3.5-flash"          # fast router/voice tier
deep_model = "gemini-3.1-pro-preview"  # heavy worker/critic tier

[brain.providers.claude-api]
auth_mode = "api_key"               # uses ANTHROPIC_API_KEY
model = "claude-haiku-4-5-20251001"
deep_model = "claude-opus-4-8"

[brain.providers.openai]
model = "gpt-5.5"
deep_model = "gpt-5.5-pro"

[brain.providers.grok]
model = "grok-4.3"
deep_model = "grok-4.3"

[brain.providers.openrouter]
model = "anthropic/claude-opus-4.8"
base_url = "https://openrouter.ai/api/v1"

# Optional current local preset. Keep the cloud-first [brain] defaults above
# unless you intentionally run this server. Start llama.cpp with the matching
# stable alias (cross-platform commands are in the local-AI guide), then make
# "local-openai" the active Brain in-app. Keep a ready provider from another
# family in the fallback chain (AP-22).
[brain.providers.local-openai]
model = "gemma-4b-qat"                     # or "nemotron-4b" at http://127.0.0.1:11442
base_url = "http://127.0.0.1:11443"

# Optional routing policy (off unless enabled). Names the provider/model for
# simple work (fast) and for multi-step reasoning or building (deep); the other
# tier is the one bounded fallback. Escalation hands a turn to a Paperclip agent
# (for example a Claude agent) only when a trigger phrase is spoken; nothing
# escalates on its own. Deny lists keep a provider family off every chain,
# including per-turn override chains. Each tier must use a provider whose
# endpoint is configured above (one base_url per provider).
# Images (screenshots, camera frames, dropped files) only go to a tier marked
# local = true. A loopback gateway that forwards to a cloud model is NOT local.
# allow_cloud_vision = true is explicit consent to send images to the other
# tiers; without a local tier such a turn is answered without any model.
# The shipped policy: the local brain answers every turn, and every paid or
# cloud brain (and Hermes) is kept off every chain, so a local failure is
# reported, never re-routed to a paid model.
[brain.route_policy]
enabled = true
allow_cloud_vision = false
deny_providers = [
  "claude-api", "claude-cli", "openai", "codex", "grok", "grok-build",
  "openrouter", "vertex", "antigravity", "nvidia", "gemini", "nous", "hermes",
  "openclaw",
]

[brain.route_policy.fast]
provider = "local-openai"
model = "gemma-4b-qat"
local = true

# Other shapes, for reference:
# [brain.route_policy.deep]
# provider = "ollama"                      # e.g. a local model server
# model = "qwen3.6:35b-a3b"
# local = true                             # runs on this machine
#
# [brain.route_policy.escalation]
# enabled = true
# via = "paperclip"                        # uses the saved Paperclip connection
# agent = "claude"                         # Paperclip agent name or urlKey
# trigger_phrases = ["ask claude"]
# deadline_s = 180
# max_per_session = 5

# ── Voice engine ──
# "pipeline" = local speech-to-text -> the local brain -> local text-to-speech.
# "realtime" (a hosted speech-to-speech model) is opt-in.
[voice]
mode = "pipeline"

# ── Safety: anti-confirmation-fatigue whitelist + hard blacklist ──
[safety]
approval_mode = "bypass"
default_tier = "safe"
always_confirm_tiers = ["ask"]
always_block_tiers = ["block"]

[safety.whitelist]
# fnmatch patterns against "<tool_name> <args>" or the bare "<args>"; a match
# downgrades to "safe". Do NOT add "run_shell *": shell commands come with a
# tiered model out of the box (Claude-Code permission style) — commands that
# only read or modify run without confirmation, destructive commands (rm,
# del, format, Remove-Item, ...) ask first UNLESS the user's own request
# already named the destruction ("delete the folder X"). A blanket
# "run_shell *" entry would switch all of that off.
commands = [
    "open_app *", "type_text *", "search_web *", "remember *",
    "dispatch_to_harness *", "screenshot *",
    "git status", "git log *", "git diff *",
]

[safety.blacklist]
commands = ["format *", "rm -rf /", "del /f /s /q C:\\", "shutdown /p", "reg delete HKLM\\*"]

# ── Audio I/O ──
[audio]
input_device = "auto"        # "auto" | shortest-unique device-name token (e.g. "PRO X")
output_device = "auto"
echo_cancellation = true       # requested; raw PortAudio reports unavailable honestly
sample_rate = 16000          # mandatory 16 kHz (AP-L-16)

# ── Browser voice (hosts without a microphone: a VPS, `jarvis serve`) ──
# The browser that presses Start holds the call over /ws/audio. Realtime mode
# always serves it; this switch covers the classic speech-to-text -> brain ->
# text-to-speech bridge in pipeline mode. See docs/headless-vps-deployment.md.
[browser_voice]
enabled = true

# ── UI / tray ──
[ui]
tray_enabled = true
admin_api_port = 47821
startup_chime = true
# On-screen overlay shown by default on a desktop install: the slim
# "jarvis_bar" (the Jarvis bar). Alternatives: "mascot" (the Gigi mascot),
# "voice_orb" (the procedural voice orb), "pet" (a desktop pet) or "none".
# This mirrors the built-in default — listed here so the bar is the obvious,
# self-documented out-of-the-box choice and never silently disappears.
orb_style = "jarvis_bar"
bar_persistent = true        # keep the bar visible at all times (not only during a voice session)
pet_id = "gigi"              # desktop pet (orb_style = "pet"): built-in id, your own u… id, or "none"
pet_scale = 1.0              # pet size multiplier, 0.5–2.0
pet_bubble = true            # show the pet's status bubble (what Jarvis is doing)
pet_strip_always = false     # true: the pet's buttons always show; false: only while active or hovered

# ── Memory ──
[memory]
recall_store = "sqlite"
archival_store = "sqlite"   # chromadb was removed; sqlite is the supported backend
data_dir = "./data"          # per-user runtime data (gitignored)

# ── Knowledge wiki (Obsidian vault) — self-creates an empty vault on first run ──
[wiki_integration]
enabled = true
vault_root = "wiki/obsidian-vault"
# Runaway guard: the most model calls the wiki may make on its own per day
# (it counts calls, it never shortens a prompt or an answer).
# max_background_llm_calls_per_day = 200

# ── Login autostart — ON by default; toggle in Settings ──
# Launches the full desktop app (voice + Orb) at login so the wake listener
# starts right after a reboot. On a headless host (no display) this is a
# graceful no-op. Set to false to opt out, or use the "App settings" toggle.
[autostart]
enabled = true

# Phase-5/6 features (vision, computer_use, admin, missions, board, telephony)
# default to enabled = false in code. Enable them individually once configured;
# see jarvis/core/config.py for every available section and its defaults.

# -- Mission workers: tool pre-authorization (ADR-0031) --
# Tools listed here are auto-approved for a mission's OWN supervisor-granted
# calls (the gate is answered on the event bus with a full audit trail, never
# bypassed). Entries are exact tool names, or an MCP server family written
# with a trailing slash (e.g. "github/"). Prefer exact names: a family prefix
# silently authorizes every future tool that server adds. Keep messaging /
# mail / social-send tools OUT unless you explicitly accept unattended sends.
# Set worker_tool_auto_approve = false to restore "every ask-tier call waits
# for a human" behavior.
[phase6.safety]
worker_tool_auto_approve = true
auto_approve_tool_families = [
  "search_web",
  "wiki-list",
  "wiki-recall",
  "wiki-page-read",
  "wiki-ingest",
  "session-latest-turn",
]

# -- Local media understanding (jarvis/multimodal) --
# Three read-only MCP tools for Hermes: media-describe-image,
# media-transcribe-audio, media-understand-video. Every model call stays on
# this computer: a non-local server_url is refused, never used. Without this
# section Jarvis auto-detects a running llama-server that accepts images or
# audio (started with --mmproj) and uses the downloaded faster-whisper model.
# [multimodal]
# server_url = "http://127.0.0.1:11439"   # "" = auto-detect on this computer
# transcriber = "auto"                    # auto | whisper | server
# whisper_model = ""                      # "" = [stt].model, then [stt].wake_model
# allowed_dirs = []                       # on top of Pictures, Videos, Music, Downloads, ...
# video_frames = 8
# max_video_seconds = 1200
